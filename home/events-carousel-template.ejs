<%
  const sourceItems = items || [];
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  function parseEventDate(value) {
    if (!value) return null;
    if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
      const parts = value.split('-').map(Number);
      return new Date(parts[0], parts[1] - 1, parts[2]);
    }
    const parsed = new Date(value);
    return isNaN(parsed.getTime()) ? null : parsed;
  }

  function getComparisonDate(item) {
    const startDate = parseEventDate(item && item.event && item.event.start_date);
    const endDate = parseEventDate(item && item.event && item.event.end_date);
    return endDate || startDate;
  }

  function isUpcoming(item) {
    const comparisonDate = getComparisonDate(item);
    if (!comparisonDate) return false;
    comparisonDate.setHours(0, 0, 0, 0);
    return comparisonDate >= today;
  }
  function isPast(item) {
    return !isUpcoming(item);
  }

  function sortAscendingByDate(a, b) {
    const da = getComparisonDate(a);
    const db = getComparisonDate(b);
    if (!da && !db) return 0;
    if (!da) return 1;
    if (!db) return -1;
    return da.getTime() - db.getTime();
  }

  function sortDescendingByDate(a, b) {
    const da = getComparisonDate(a);
    const db = getComparisonDate(b);
    if (!da && !db) return 0;
    if (!da) return 1;
    if (!db) return -1;
    return db.getTime() - da.getTime();
  }

  // String version, e.g. "Aug 12" — used in the subtitle line if needed
  function formatEventDate(item) {
    const startDate = parseEventDate(item && item.event && item.event.start_date);
    if (!startDate) return '';
    return startDate.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    });
  }

  // Object version, e.g. { day: "12", month: "AUG" } 
  function getEventDayMonth(item) {
    const startDate = parseEventDate(item && item.event && item.event.start_date);
    if (!startDate) return { day: '', month: '' };
    const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
    return {
      day: String(startDate.getDate()),
      month: months[startDate.getMonth()]
    };
  }

  function getEventType(item) {
    if (!item) return 'Event';
    if (item.event && item.event.format && item.event.format.type) {
      return item.event.format.type;
    }
    if (Array.isArray(item.categories) && item.categories.length) {
      return item.categories[0];
    }
    if (item.categories) return item.categories;
    return 'Event';
  }

    function getEventDescription(item) {
    if (!item) return '';
    if (item.event && item.event.card_description) return item.event.card_description;
    if (item.description) return item.description;
    return 'See event details from the LMU Open Science Center.';
  }

  const upcoming = sourceItems.filter(isUpcoming).sort(sortAscendingByDate);
  const past = sourceItems.filter((item) => !isUpcoming(item)).sort(sortDescendingByDate);

  const MAX_ITEMS = 2;
  let displayItems = upcoming.slice();
  if (displayItems.length < MAX_ITEMS) {
    const required = MAX_ITEMS - displayItems.length;
    displayItems = displayItems.concat(past.slice(0, required));
  } else {
    displayItems = displayItems.slice(0, MAX_ITEMS);
  }
%>

<!--section header-->
<div class="card-header bg-transparent fw-semibold justify-content-between d-flex align-items-center">
    <span><strong>Events</strong></span>
    <a href="events/index.qmd" class="events-header-link text-decoration-none text-black" aria-label="View all events">All Events <i class="bi bi-arrow-up-right-square-fill small"></i></a>
</div>
<!--actual cards-->
<div class="card events-card mt-3 h-100 border-0" style="background:none;">
  <div class="card-body d-flex flex-column gap-4">
    <% displayItems.forEach((item) => {
      const dm = getEventDayMonth(item);
      const category = (item.categories && item.categories.length > 0)
        ? item.categories[0]
        : '';

        const catImg = category
        ? category.toLowerCase().replace(/ /g, '_').replace(/-/g, '_')
        : 'default';

        const hasCardImage = !!item.card_image;
        const imgBase = `/events/images/${catImg}`;
        const imgSrc = hasCardImage
        ? item.card_image
        : `${imgBase}.svg`;
    %>
    <div class="card events-card shadow-sm">
        <div class="row g-0">
            <div class="col-md-2 p-3 d-none d-md-block align-content-center">
            <% if (hasCardImage) { %>
                <img src="<%- imgSrc %>" onerror="this.onerror=null; this.src='/events/images/default.svg';"class="img-fluid rounded event-card-image" alt="<%- category %>">
            <% } else { %>
                <img src="<%- imgSrc %>" onerror="if(!this._tried){this._tried=1; this.src='<%- imgBase %>.png';}else if(this._tried==1){this._tried=2; this.src='<%- imgBase %>.jpg';}else if(this._tried==2){this._tried=3; this.src='<%- imgBase %>.jpeg';}else{this.onerror=null; this.src='/events/images/default.svg';}" 
                class="img-fluid rounded event-card-image" alt="<%- category %>">
            <% } %>
            </div>
            <div class="col-md-10">
                <div class="card-body text-start position-relative pe-5">
                    <% if (isPast(item)) { %>
                    <h6 class="card-subtitle mb-2 text-body-secondary" style="font-size:0.87rem;">Past Event &middot; <%- getEventType(item) %> &middot; <%= formatEventDate(item) %></h6>
                    <% } else { %>
                    <h6 class="card-subtitle mb-2 text-body-secondary" style="font-size:0.87rem;"><%- getEventType(item) %> &middot; <%= formatEventDate(item) %></h6>
                    <% } %>
                    <h6 class="card-title fw-bold "><%- item.title %></h6>
                    <p class="card-text d-none d-sm-block text-muted text-truncate"><%- getEventDescription(item) %></p>
                    <i class="bi bi-arrow-right card-arrow" aria-hidden="true"></i>
                </div>
            </div>
        </div>
       <a href="<%- item.path %>" class="stretched-link" aria-label="See details for <%- item.title %>"></a>
    </div>
    <% }); %>
  </div>
</div>

