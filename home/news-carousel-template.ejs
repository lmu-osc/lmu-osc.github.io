```{=html}
<%
  const carouselItems = (items || []).slice(0, 2);

  function formatNewsDate(value) {
    if (!value) return '';
    const date = new Date(value);
    if (isNaN(date.getTime())) return '';
    return date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    });
  }

  function getNewsDescription(item) {
    if (!item) return '';
    if (item.description) return item.description;
    if (item.subtitle) return item.subtitle;
    return 'Read the latest update from the LMU Open Science Center.';
  }
%>
<div class="card-header bg-transparent fw-semibold justify-content-between d-flex align-items-center">
    <span><strong>News</strong></span>
    <a href="news/index.qmd" class="news-header-link text-decoration-none text-black" aria-label="View all news">
      All News <i class="bi bi-arrow-up-right-square-fill small"></i>
    </a>
</div>
<!--actual cards-->
<div class="card news-card mt-3 h-100 border-0" style="background:none;">
  <div class="card-body d-flex flex-column gap-4">
    <% carouselItems.forEach((item, index) => { %>
    <div class="card news-card shadow-sm">
      <div class="row g-0">
          <div class="col-md-12 position-relative pe-5">
              <div class="card-body text-start">
                  <h6 class="card-subtitle mb-2 text-body-secondary" style="font-size:0.87rem;"><%= formatNewsDate(item.date) %></h6>
                  <h6 class="card-title fw-bold "><%- item.title %></h6>
                  <p class="card-text d-none d-sm-block text-muted text-truncate"><%- item.description %></p>
                  <i class="bi bi-arrow-right card-arrow" aria-hidden="true"></i>
                  <a href="<%- item.path %>" class="stretched-link" aria-label="See details for <%- item.title %>"></a>
              </div>
          </div>
      </div>
    </div>
    <% }); %>
  </div>
</div>
```